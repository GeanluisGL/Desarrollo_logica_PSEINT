Proceso EsPrimo
    Definir num, i, c Como Entero
    Escribir "Ingresa un número entero positivo:"
    Leer num
    
    c <- 0
    
    Para i <- 1 Hasta num Hacer
        Si num MOD i = 0 Entonces
            c <- c + 1
        FinSi
    FinPara
    
    Si c = 2 Entonces
        Escribir "El número ", num, " ES primo."
    Sino
        Escribir "El número ", num, " NO es primo."
    FinSi
FinProceso
